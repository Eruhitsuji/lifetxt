{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/backup-integrity-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "files",
    "manifest_sha256"
  ],
  "title": "lifetxt recovery backup integrity manifest v1",
  "type": "object"
}
