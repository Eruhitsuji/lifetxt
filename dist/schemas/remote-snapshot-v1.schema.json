{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/remote-snapshot-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "projects": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "read_only": {
      "type": "boolean"
    },
    "revision": {
      "type": "string"
    },
