{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/timezone-policy-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "aware_values": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "fold_policy": {
      "enum": [
        "error",
        "earlier",
        "later"
      ]
    },
    "gap_policy": {
      "enum": [
        "error",
        "next",
        "previous"
      ]
    },
    "naive_values": {
      "type": "string"
    },
    "precedence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "sample": {
      "type": "object"
    },
    "source": {
      "enum": [
        "cli",
        "file",
        "config",
        "host"
      ]
    },
    "time_only_values": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    }
  },
  "required": [
    "timezone",
    "source",
    "valid",
    "precedence",
    "fold_policy",
    "gap_policy"
  ],
  "title": "lifetxt timezone policy v1",
  "type": "object"
}
