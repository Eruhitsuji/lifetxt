{
  "Task item": {
    "prefix": "task",
    "body": "[ ] T \"${1:Title}\" due:${2:YYYY-MM-DD} project:${3:project}",
    "description": "Create a task item."
  },
  "Nested task item": {
    "prefix": "subtask",
    "body": "  [ ] T \"${1:Subtask}\" id:${2:task_sub} due:${3:YYYY-MM-DD}",
    "description": "Create an indented subtask item."
  },
  "Event item": {
    "prefix": "event",
    "body": "[ ] E \"${1:Title}\" from:${2:YYYY-MM-DDT13:00} to:${3:YYYY-MM-DDT14:30} loc:\"${4:location}\"",
    "description": "Create an event item."
  },
  "Status item": {
    "prefix": "status",
    "body": "[/] S \"${1:Working}\" from:${2:YYYY-MM-DDT14:00} state:${3|available,busy,away,offline,dnd,focus,sleeping,commuting,working,studying,meeting,custom|} person:${4:self}",
    "description": "Create a status / presence item."
  },
  "Message item": {
    "prefix": "message",
    "body": "[ ] M \"${1:Title}\" sender:${2:self} recipient:${3:alice} notify_at:${4:YYYY-MM-DDT09:00} body:\"${5:message}\"",
    "description": "Create a message item."
  },
  "Journal item": {
    "prefix": "journal",
    "body": [
      "[N] J \"${1:Title}\" on:${2:YYYY-MM-DD} mood:${3:good}",
      "| ${4:Body text}"
    ],
    "description": "Create a journal item with a body continuation."
  },
  "Habit item": {
    "prefix": "habit",
    "body": "[ ] H \"${1:Habit}\" repeat:${2|daily,weekly,monthly,yearly,weekdays|} at:${3:18:00} project:${4:project}",
    "description": "Create a habit item."
  },
  "Recurring habit with limits": {
    "prefix": "repeat-limited",
    "body": "[ ] H \"${1:Habit}\" repeat:${2|daily,weekly,monthly,yearly,weekdays|} interval:${3:2} on:${4:YYYY-MM-DD} until:${5:YYYY-MM-DD} count:${6:10}",
    "description": "Create a recurring item with interval, until, and count."
  },
  "Body continuation": {
    "prefix": "body",
    "body": "| ${1:Body text}",
    "description": "Add a body continuation line."
  },
  "Indented body continuation": {
    "prefix": "ibody",
    "body": "  | ${1:Body text}",
    "description": "Add an indented body continuation line."
  },
  "ID detail": {
    "prefix": "id",
    "body": "id:${1:item_001}",
    "description": "Stable item ID."
  },
  "Parent detail": {
    "prefix": "parent",
    "body": "parent:${1:item_001}",
    "description": "Parent item ID."
  },
  "Depends on detail": {
    "prefix": "depends_on",
    "body": "depends_on:${1:item_001}",
    "description": "Prerequisite item ID."
  },
  "Blocks detail": {
    "prefix": "blocks",
    "body": "blocks:${1:item_001}",
    "description": "Blocked downstream item ID."
  },
  "Due detail": {
    "prefix": "due",
    "body": "due:${1:YYYY-MM-DD}",
    "description": "Deadline date or datetime."
  },
  "From/to details": {
    "prefix": "fromto",
    "body": "from:${1:YYYY-MM-DDT13:00} to:${2:YYYY-MM-DDT14:30}",
    "description": "Start and end datetime details."
  },
  "Timezone datetime": {
    "prefix": "dtz",
    "body": "${1:YYYY-MM-DDT13:00:30.25+09:00}",
    "description": "Datetime with fractional seconds and explicit timezone."
  },
  "Tag detail": {
    "prefix": "tag",
    "body": "tag:${1:tag}",
    "description": "Tag detail."
  },
  "Project detail": {
    "prefix": "project",
    "body": "project:${1:project}",
    "description": "Project detail."
  },
  "Deadline item": {
    "prefix": "deadline",
    "body": "[ ] D \"${1:Title}\" due:${2:YYYY-MM-DD}",
    "description": "Create a deadline; explicitly enter its date."
  },
  "Reminder item": {
    "prefix": "reminder",
    "body": "[ ] R \"${1:Title}\" on:${2:YYYY-MM-DD} at:${3:09:00}",
    "description": "Create a reminder; explicitly enter its date and time."
  },
  "Note item": {
    "prefix": "note",
    "body": "[N] N \"${1:Title}\"\n| ${2:Body text}",
    "description": "Create a note with body continuation."
  },
  "Planned execution detail": {
    "prefix": "do",
    "body": "do:${1:YYYY-MM-DD}",
    "description": "Planned execution date; due: is the deadline."
  }
}
