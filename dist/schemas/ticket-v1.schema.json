          "type": "string"
        },
        "ticket_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "tracker": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "watchers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "status"
      ],
      "type": "object"
    }
  },
  "required": [
    "summary",
    "fields",
    "relations"
  ],
  "title": "lifetxt development ticket v1",
  "type": "object"
}
