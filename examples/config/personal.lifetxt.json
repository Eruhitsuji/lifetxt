{
  "config_version": 1,
  "default_workspace": "personal",
  "config": {
    "write": {
      "require_revision": false
    }
  },
  "workspaces": {
    "personal": {
      "sources": [
        "life.txt",
        { "path": ".generated/google_calendar.life.txt", "role": "generated" }
      ],
      "write_file": "life.txt"
    }
  },
  "web": {
    "top_clock": { "enabled": true, "format": "HH:mm:ss", "show_date": true }
  },
  "defaults": {
    "person": "self",
    "timezone": "Asia/Tokyo"
  }
}
