{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/workspace-diagnostics-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "diagnostic_count": {
      "minimum": 0,
      "type": "integer"
    },
    "diagnostics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "column": {
            "type": [
              "integer",
              "null"
            ]
          },
          "hint": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "span": {
            "additionalProperties": false,
            "properties": {
              "end": {
                "additionalProperties": false,
                "properties": {
                  "column": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "line": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "line",
                  "column"
                ],
                "type": "object"
              },
              "start": {
                "additionalProperties": false,
                "properties": {
                  "column": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "line": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "line",
                  "column"
                ],
                "type": "object"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "type": "object"
          }
        },
        "required": [
          "severity",
          "code",
          "message",
          "source",
          "line",
          "column",
          "span",
          "hint"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "file_reports": {
      "type": "object"
    },
    "item_count": {
      "minimum": 0,
      "type": "integer"
    },
    "ok": {
      "type": "boolean"
    },
    "paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "severity_counts": {
      "type": "object"
    }
  },
  "required": [
    "ok",
    "paths",
    "item_count",
    "diagnostic_count",
    "severity_counts",
    "diagnostics"
  ],
  "title": "lifetxt workspace diagnostics v1",
  "type": "object"
}
