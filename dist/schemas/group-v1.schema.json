{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/group-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "disabled_members": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "group_version": {
      "const": "1"
    },
    "members": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "name": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "group_version",
    "name",
    "members"
  ],
  "title": "lifetxt group definition v1",
  "type": "object"
}
