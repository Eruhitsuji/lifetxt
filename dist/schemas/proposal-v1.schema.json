{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/proposal-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "changes": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "expected_revision": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "proposal_version": {
