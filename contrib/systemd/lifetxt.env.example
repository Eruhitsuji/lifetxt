# Copy this file to /etc/lifetxt/lifetxt.env and fill in your real Calendar
# URL. Then:
#   chmod 600 /etc/lifetxt/lifetxt.env
#   chown lifetxt:lifetxt /etc/lifetxt/lifetxt.env
#
# This file is read only by lifetxt-sync-ics.service (via EnvironmentFile=).
# It is NOT read by lifetxt.service -- that unit's paths/port are literal
# values in contrib/systemd/lifetxt.service, edited directly.
#
# NEVER commit a filled-in copy of this file. A Calendar URL is sensitive:
# treat it like a password, not like a public link.

# iCalendar URL for `lifetxt sync-ics --url-env LIFETXT_GOOGLE_CAL_ICS`.
# Example shape (not a real URL):
#   LIFETXT_GOOGLE_CAL_ICS=https://calendar.google.com/calendar/ical/REPLACE_ME/private-REPLACE_ME/basic.ics
LIFETXT_GOOGLE_CAL_ICS=
