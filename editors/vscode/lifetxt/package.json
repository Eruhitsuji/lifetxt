{
  "name": "lifetxt",
  "displayName": "life.txt",
  "description": "Syntax highlighting and snippets for the life.txt plain-text planning format.",
  "version": "0.2.0",
  "publisher": "lifetxt",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lifetxt",
        "aliases": [
          "life.txt",
          "Life Text"
        ],
        "extensions": [
          ".lifetxt",
          ".life.txt"
        ],
        "filenames": [
          "life.txt"
        ],
        "filenamePatterns": [
          "*.life.txt",
          "*_life.txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lifetxt",
        "scopeName": "source.lifetxt",
        "path": "./syntaxes/lifetxt.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lifetxt",
        "path": "./snippets/lifetxt.code-snippets"
      }
    ],
    "configuration": {
      "title": "life.txt",
      "properties": {
        "lifetxt.languageServer.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Opt in to the read-only Python language server. Trusted workspaces only. Reload window after changes; no automatic installation. Added in 0.2.0; non-secret; disabling restores static-only behavior."
        },
        "lifetxt.languageServer.python": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Executable path (one program, no shell arguments) in the extension host environment containing lifetxt. Reload window after changes. Added in 0.2.0; non-secret. Not read from life.txt/Core configuration."
        }
      }
    }
  },
  "scripts": {
    "test:grammar": "node test/grammar.cjs",
    "test:activation": "node test/activation.cjs",
    "test:protocol": "node test/protocol.cjs"
  },
  "devDependencies": {
    "vscode-textmate": "9.3.2",
    "vscode-oniguruma": "2.0.1"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:lifetxt"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Static features only; language server disabled in untrusted workspaces.",
      "restrictedConfigurations": [
        "lifetxt.languageServer.enabled",
        "lifetxt.languageServer.python"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Use static features for remote/virtual document providers."
    }
  },
  "optionalDependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
