{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lifetxt Desktop",
  "version": "0.1.0",
  "identifier": "com.lifetxt.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "lifetxt",
        "width": 1280,
        "height": 800,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "resources/bin/*": "bin/"
    }
  }
}
