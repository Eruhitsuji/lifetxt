# Copy to .env and fill in real values before running `docker compose up`.
# .env is already ignored by the repository's leading `.*` gitignore rule.

# Required: bearer token clients must send to reach the Web API/UI.
# Generate one with e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
LIFETXT_API_TOKEN=change-me

# Optional: pin to an immutable released version instead of the floating
# `latest` convenience tag. See docs/en/distribution.md for the tag policy.
# LIFETXT_VERSION=1.0.0

# Optional: host port to publish the container's port 8000 on.
# LIFETXT_HOST_PORT=8000
