{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/multi-target-result-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compensated": {
      "type": "boolean"
    },
    "journal_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "type": "string"
    },
    "recovery_required": {
      "type": "boolean"
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "after_hash": {
            "type": "string"
          },
          "before_hash": {
            "type": "string"
          },
          "changed": {
            "type": "boolean"
          },
          "created": {
            "type": "boolean"
          },
          "deleted": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "text",
              "json",
              "bytes"
            ]
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "kind",
          "before_hash",
          "after_hash",
          "changed",
          "created",
          "deleted"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "transaction_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "operation",
    "targets",
    "compensated"
  ],
  "title": "lifetxt multi-target mutation result v1",
  "type": "object"
}
