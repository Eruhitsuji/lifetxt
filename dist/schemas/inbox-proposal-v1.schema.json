{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/inbox-proposal-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "changes": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "created": {
      "type": "string"
    },
    "expected_revision": {
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "proposal_version": {
      "const": "1"
    },
    "provenance": {
      "type": "object"
    },
    "source": {
      "type": "string"
    },
    "staged_target": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "deferred"
      ]
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "proposal_version",
    "id",
    "operation",
    "source",
    "changes",
    "status"
  ],
  "title": "lifetxt inbox proposal v1",
  "type": "object"
}
