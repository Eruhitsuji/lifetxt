{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/query-plan-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "date_filters": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "op": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "op",
          "date"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "details": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "diagnostics": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "excludes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "membership": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "open_only": {
      "type": "boolean"
    },
    "query": {
      "type": "string"
    },
    "text": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "query",
    "membership",
    "date_filters",
    "text",
    "open_only"
  ],
  "title": "lifetxt compiled query plan v1",
  "type": "object"
}
