{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/remote-profile-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "poll_seconds": {
      "minimum": 1,
      "type": "number"
    },
    "profile_version": {
      "const": "1"
    },
    "read_only": {
      "type": "boolean"
    },
    "token_env": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "pattern": "^https://",
      "type": "string"
    }
  },
  "required": [
    "profile_version",
    "name",
    "url",
    "read_only"
  ],
  "title": "lifetxt remote profile v1",
  "type": "object"
}
