.*
!.gitignore
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.vscode/
!.vscode/settings.json
!.dockerignore
__pycache__/
*.py[cod]

# Produced by `pip install .` / `pip install -e .` and `python -m build`.
# `.venv/` is already covered by the leading `.*` rule. `dist/schemas/` is a
# tracked, real directory (generated schema bundle), so `dist/` itself is
# deliberately not ignored here -- only the setuptools intermediate build
# directory, which has no tracked content.
*.egg-info/
/build/

# PyInstaller standalone binary output (#570). dist/schemas/ above is the
# only tracked content anywhere under dist/.
/dist/standalone/

# Generated per-release package-manager manifests (#571, #572). The scripts
# and templates that produce these are tracked; their per-release output is
# not.
/packaging/winget/generated/
/packaging/scoop/generated/
/packaging/homebrew/generated/

# AI Development Standard
!.ai/
!.ai/**
!.kiro/
!.kiro/**

# Rust build artifacts (desktop/src-tauri). Cargo.lock is intentionally
# tracked, matching convention for a binary crate. gen/ is regenerated by
# tauri-build on every `cargo build` (ACL/capability schema files).
desktop/src-tauri/target/
desktop/src-tauri/gen/
