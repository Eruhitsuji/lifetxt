{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/revision-metrics-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "last_persisted_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_reset_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "legacy_fallback_by_path": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "type": "object"
    },
    "legacy_fallback_enabled": {
      "type": "boolean"
    },
    "legacy_fallback_last_used": {
      "type": [
        "string",
        "null"
      ]
    },
    "legacy_fallback_total": {
      "minimum": 0,
      "type": "integer"
    },
    "metrics_path": {
      "type": "string"
    },
    "migration_window_days": {
      "minimum": 0,
      "type": "integer"
    },
    "observation_days": {
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "observation_started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "ready_to_require_revisions": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "removal_condition": {
      "type": "string"
    },
    "required_observation_days": {
      "minimum": 0,
      "type": "integer"
    },
    "revision_mode": {
      "enum": [
        "observe",
        "required"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "server_instance_id": {
      "type": "string"
    },
    "zero_usage": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "revision_mode",
    "migration_window_days",
    "legacy_fallback_total",
    "legacy_fallback_by_path",
    "ready_to_require_revisions"
  ],
  "title": "lifetxt revision migration metrics v1",
  "type": "object"
}
