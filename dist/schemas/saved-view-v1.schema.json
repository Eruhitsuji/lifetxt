{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/saved-view-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "limit": {
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "sort": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "view_version": {
      "const": "1"
    }
  },
  "required": [
    "view_version",
    "name",
    "query"
  ],
  "title": "lifetxt saved view v1",
  "type": "object"
}
