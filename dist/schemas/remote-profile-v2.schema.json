{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/remote-profile-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "profiles": {
      "additionalProperties": {
        "properties": {
          "token_env": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "verify_tls": {
            "type": "boolean"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "version": {
      "const": 2
    }
  },
  "required": [
    "version",
    "profiles"
  ],
  "title": "Remote profile store",
  "type": "object"
}
