{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/ticket-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "activity": {
      "type": "object"
    },
    "custom_fields": {
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "type": "object"
    },
    "elapsed": {
      "type": [
        "string",
        "null"
      ]
    },
    "est": {
      "type": [
        "string",
        "null"
      ]
    },
    "fields": {
      "type": "object"
    },
    "incoming_links": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "planning": {
      "type": "object"
    },
    "relations": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "resolution": {
      "type": [
        "string",
        "null"
