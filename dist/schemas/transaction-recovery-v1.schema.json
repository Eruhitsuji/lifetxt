{
  "$id": "https://github.com/Eruhitsuji/lifetxt/raw/main/dist/schemas/transaction-recovery-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "available_actions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "journal_path": {
      "type": "string"
    },
    "observed_targets": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "operation": {
      "type": "string"
    },
    "recovery_required": {
      "type": "boolean"
    },
    "state": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "operation",
    "state",
    "journal_path",
    "recovery_required",
    "observed_targets",
    "available_actions"
  ],
  "title": "lifetxt transaction recovery report v1",
  "type": "object"
}
